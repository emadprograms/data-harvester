*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/

# VSCode
.vscode/
.DS_Store

# Logs
logs/

# Local Databases
*.db
*.sqlite

# Temporary folders
buy_cash/

# Agent/Gemini folders
.agent/
.gemini/
