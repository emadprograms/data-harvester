# Capital.com API Credentials
CAPITAL_COM_X_CAP_API_KEY=your_capital_api_key_here
CAPITAL_COM_IDENTIFIER=your_capital_identifier_here
CAPITAL_COM_PASSWORD=your_capital_password_here

# Massive / Polygon.io API Keys (comma-separated for multi-key rotation)
MASSIVE_API_KEYS=key1,key2,key3

# Discord Webhook Notification (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Additional Provider Keys (Optional Fallbacks)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# ==============================================================================
# Storage & Tick Lake Configuration (Milestone v4.0)
# ==============================================================================
# TICK_LAKE_ROOT: Path to Partitioned Parquet Tick Lake root
# Default resolution precedence:
#   1. TICK_LAKE_ROOT
#   2. DATA_DIR/tick_lake
#   3. /Volumes/Micron-E 0256 A/data-harvester/data/tick_lake
#   4. <repo_root>/data/tick_lake
TICK_LAKE_ROOT=data/tick_lake

# DATA_DIR: Base directory for historical database and default tick_lake parent
DATA_DIR=data

# ==============================================================================
# Streaming Engine & Ingestion Performance Knobs
# ==============================================================================
# STATUS (v4.1): the STREAM_* variables below are NOT yet read by the runtime.
# They are reserved placeholders; the effective values are constructor defaults:
#   StreamingEngine(flush_interval=2.0, max_queue_size=10000)  -> streamer process
#   TickLakeWriter(max_batch_rows=5000, flush_interval_seconds=5.0,
#                  max_queue_size=10000, compression="snappy")
# See docs/operations/tick_lake_operations_guide.md §2.2 for the full settings table.
# Wiring these variables is a tracked backlog item in .planning/ROADMAP.md.
STREAM_FLUSH_INTERVAL=2.0

# STREAM_MAX_BATCH_ROWS: Reserved (effective writer default: 5000 rows per atomic parquet batch)
STREAM_MAX_BATCH_ROWS=1000

# STREAM_MAX_QUEUE_SIZE: Reserved (effective default: 10000 in-flight ticks with backpressure)
STREAM_MAX_QUEUE_SIZE=10000

# STREAM_COMPRESSION: Reserved (effective default: "snappy")
# STREAM_COMPRESSION=snappy

# ==============================================================================
# Dashboard
# ==============================================================================
# DASHBOARD_PORT: Dashboard HTTP port (default 8420; fallbacks 8421/8422/8425)
# DASHBOARD_PORT=8420
